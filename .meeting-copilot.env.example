# Saved automatically by the extension setup wizard.
MEETING_COPILOT_CHATGPT_PROJECT_URL='https://chatgpt.com/g/g-p-PROJECT_ID/project'

# install-control-ui.sh generates an installation-specific value when omitted.
# MEETING_COPILOT_CDP_PORT=9223
# Optional migration override: auto (default), custom, or blackhole.
# MEETING_COPILOT_AUDIO_BACKEND=auto

# Copy these entries into the gitignored .meeting-copilot.env (chmod 600).
# Preserve the random MEETING_COPILOT_CDP_PORT already generated by setup.
# Use the FastAPI base URL, not the Vercel frontend URL; do not append /v1.
GASTROBRAIN_API_URL=https://your-gastrobrain-api.example.com
MEETING_AGENT_TOKEN=replace-with-the-backend-shared-token
# Must match the Slack/Gastrobrain identity signed into the agent tab.
MEETING_COPILOT_OPERATOR_EMAIL=itsuki.son@gastroduce-japan.co.jp
MEETING_COPILOT_AGENT_URL=https://gastron-brain-web.vercel.app/voice?mode=meeting
